#!/usr/bin/env bash
# Corre las pruebas E2E (Playwright en Docker) contra el servidor en marcha (bin/rails server).
set -euo pipefail
cd "$(dirname "$0")/.."
TOKEN="${QA_PULSE_TOKEN:-$(bin/rails runner 'print Project.find_by!(slug: "tienda-demo").api_token')}"
# Al terminar, borra lo que crean las pruebas (proyectos "E2E …" y ejecuciones de la rama "e2e")
# para no ensuciar los datos de la demo.
cleanup() {
  bin/rails runner '
    runs = Run.where("branch LIKE ?", "e2e%").or(Run.where(project_id: Project.where("name LIKE ?", "E2E %").select(:id)))
    TestResult.where(run_id: runs.select(:id)).delete_all
    runs.delete_all
    Project.where("name LIKE ?", "E2E %").delete_all
  '
}
trap cleanup EXIT
docker run --rm --network host -u "$(id -u):$(id -g)" -e HOME=/tmp -e QA_PULSE_TOKEN="$TOKEN" \
  -e QA_PULSE_URL="${QA_PULSE_URL:-http://127.0.0.1:3000}" \
  -v "$PWD/e2e":/work -v "$PWD/spec/fixtures":/fixtures:ro -w /work \
  mcr.microsoft.com/playwright:v1.59.0-noble \
  bash -c 'npm install --no-audit --no-fund --silent >/dev/null 2>&1; npx playwright test --reporter=list "$@"' _ "$@"
