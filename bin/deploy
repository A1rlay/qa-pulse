#!/usr/bin/env bash
# Despliega QA Pulse en un VPS que ya tiene Docker y Traefik (Coolify, Dokploy o Traefik propio).
#
#   bin/deploy root@74.208.250.0 --check   # solo LEE el servidor: Docker, Traefik, red, recursos
#   bin/deploy root@74.208.250.0 --apply   # construye la imagen aquí, la sube por SSH y la levanta
#
# Variables opcionales:
#   APP_HOST       dominio público (por defecto qa-pulse.<ip>.sslip.io)
#   REMOTE_DIR     carpeta en el servidor (por defecto /opt/qa-pulse)
#   TRAEFIK_NETWORK, TRAEFIK_CERTRESOLVER, TRAEFIK_HTTPS_ENTRYPOINT, TRAEFIK_HTTP_ENTRYPOINT
#                  para forzar valores si la detección automática no acierta.
#   CURL_INSECURE=1 solo para pruebas locales con un certificado autofirmado.
#
# Los secretos (contraseñas de MySQL, SECRET_KEY_BASE) se generan EN el servidor la primera vez,
# en REMOTE_DIR/.env (modo 600), y nunca se sobrescriben ni salen del servidor.
set -euo pipefail
cd "$(dirname "$0")/.."

TARGET="${1:-}"
MODE="${2:---check}"
if [[ -z "$TARGET" || ! "$MODE" =~ ^--(check|apply)$ ]]; then
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
fi

HOST_IP="${TARGET#*@}"
APP_HOST="${APP_HOST:-qa-pulse.${HOST_IP}.sslip.io}"
REMOTE_DIR="${REMOTE_DIR:-/opt/qa-pulse}"
SSH=(ssh -o ConnectTimeout=15 "$TARGET")

say() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

# ---------- 1. Inspección (solo lectura) ----------
say "Inspeccionando $TARGET (solo lectura)"
DETECT="$("${SSH[@]}" 'bash -s' <<'REMOTE'
set -u
echo "arch=$(uname -m)"
echo "os=$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")"
echo "docker=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo NO)"
echo "compose=$(docker compose version --short 2>/dev/null || echo NO)"
echo "mem_mb=$(free -m | awk '/Mem:/ {print $7}')"
echo "disk_gb=$(df -BG --output=avail / | tail -1 | tr -dc 0-9)"
proxy=$(docker ps --format '{{.Names}} {{.Image}}' 2>/dev/null | awk '$2 ~ /traefik/ {print $1; exit}')
echo "proxy=${proxy:-NONE}"
if [ -n "$proxy" ]; then
  echo "proxy_networks=$(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$proxy")"
  args="$(docker inspect -f '{{join .Args " "}} {{join .Config.Cmd " "}}' "$proxy" 2>/dev/null)"
  # Dokploy y otros configuran Traefik con un archivo estático en lugar de argumentos.
  for f in /etc/dokploy/traefik/traefik.yml /data/coolify/proxy/traefik.yml /etc/traefik/traefik.yml; do
    [ -r "$f" ] && args="$args $(tr '\n' ' ' < "$f")"
  done
  echo "resolver=$(grep -oE 'certificatesresolvers\.[A-Za-z0-9_-]+' <<<"$args" | head -1 | cut -d. -f2)"
  echo "resolver_yaml=$(grep -oE 'certificatesResolvers: *[A-Za-z0-9_-]+' <<<"$args" | head -1 | awk '{print $2}')"
  echo "entrypoints=$(grep -oE 'entrypoints\.[A-Za-z0-9_-]+\.address=:[0-9]+' <<<"$args" | sed 's/entrypoints\.//; s/\.address=:/:/' | tr '\n' ' ')"
fi
echo "platform=$( (docker ps --format '{{.Names}}' | grep -qx coolify && echo coolify) || (docker ps --format '{{.Names}}' | grep -q '^dokploy' && echo dokploy) || echo traefik)"
echo "existing=$(docker ps -a --format '{{.Names}}' | grep -c '^qa-pulse' || true)"
REMOTE
)"
echo "$DETECT"
get() { sed -n "s/^$1=//p" <<<"$DETECT"; }

[[ "$(get docker)" == "NO" ]] && { echo "El servidor no tiene Docker." >&2; exit 1; }
[[ "$(get compose)" == "NO" ]] && { echo "El servidor no tiene 'docker compose'." >&2; exit 1; }
[[ "$(get proxy)" == "NONE" ]] && { echo "No encontré un contenedor de Traefik en el servidor." >&2; exit 1; }

PLATFORM="$(get platform)"
# Valores conocidos por plataforma; la detección los corrige si encuentra otros.
case "$PLATFORM" in
  coolify) d_net=coolify;         d_res=letsencrypt; d_https=https;     d_http=http ;;
  dokploy) d_net=dokploy-network; d_res=letsencrypt; d_https=websecure; d_http=web ;;
  *)       d_net="$(get proxy_networks | awk '{print $1}')"; d_res=letsencrypt; d_https=websecure; d_http=web ;;
esac
det_res="$(get resolver)"; [[ -z "$det_res" ]] && det_res="$(get resolver_yaml)"
eps="$(get entrypoints)"
det_https="$(tr ' ' '\n' <<<"$eps" | awk -F: '$2==443 {print $1; exit}')"
det_http="$(tr ' ' '\n' <<<"$eps" | awk -F: '$2==80 {print $1; exit}')"
proxy_nets="$(get proxy_networks)"
det_net="$(tr ' ' '\n' <<<"$proxy_nets" | grep -x "$d_net" || tr ' ' '\n' <<<"$proxy_nets" | grep -v '^bridge$' | head -1)"

TRAEFIK_NETWORK="${TRAEFIK_NETWORK:-${det_net:-$d_net}}"
TRAEFIK_CERTRESOLVER="${TRAEFIK_CERTRESOLVER:-${det_res:-$d_res}}"
TRAEFIK_HTTPS_ENTRYPOINT="${TRAEFIK_HTTPS_ENTRYPOINT:-${det_https:-$d_https}}"
TRAEFIK_HTTP_ENTRYPOINT="${TRAEFIK_HTTP_ENTRYPOINT:-${det_http:-$d_http}}"
ARCH="$(get arch)"; case "$ARCH" in x86_64) PLATFORM_FLAG=linux/amd64 ;; aarch64|arm64) PLATFORM_FLAG=linux/arm64 ;; *) PLATFORM_FLAG=linux/amd64 ;; esac

say "Plan"
cat <<EOF
  Plataforma detectada : $PLATFORM
  URL pública          : https://$APP_HOST
  Carpeta remota       : $REMOTE_DIR
  Red de Traefik       : $TRAEFIK_NETWORK
  Cert. resolver       : $TRAEFIK_CERTRESOLVER
  Entrypoints          : $TRAEFIK_HTTPS_ENTRYPOINT (https), $TRAEFIK_HTTP_ENTRYPOINT (http)
  Imagen               : $PLATFORM_FLAG, construida en esta máquina y enviada por SSH
  Memoria libre / disco: $(get mem_mb) MB / $(get disk_gb) GB
EOF

if [[ "$MODE" == "--check" ]]; then
  echo
  echo "Solo inspección: no se cambió nada. Para desplegar: bin/deploy $TARGET --apply"
  exit 0
fi

# ---------- 2. Construir y enviar la imagen ----------
SHA="$(git rev-parse --short HEAD)"
[[ -n "$(git status --porcelain)" ]] && SHA="$SHA-dirty"
IMAGE="qa-pulse:$SHA"

say "Construyendo $IMAGE ($PLATFORM_FLAG)"
docker build --platform "$PLATFORM_FLAG" -t "$IMAGE" .

say "Enviando la imagen al servidor (puede tardar unos minutos)"
docker save "$IMAGE" | gzip -1 | "${SSH[@]}" 'gunzip | docker load'

# ---------- 3. Configuración y arranque ----------
say "Subiendo compose.yml y preparando $REMOTE_DIR"
"${SSH[@]}" "mkdir -p '$REMOTE_DIR' && chmod 700 '$REMOTE_DIR'"
scp -q -o ConnectTimeout=15 deploy/compose.yml "$TARGET:$REMOTE_DIR/compose.yml"

"${SSH[@]}" "REMOTE_DIR='$REMOTE_DIR' IMAGE='$IMAGE' APP_HOST='$APP_HOST' TRAEFIK_NETWORK='$TRAEFIK_NETWORK' \
  TRAEFIK_CERTRESOLVER='$TRAEFIK_CERTRESOLVER' TRAEFIK_HTTPS_ENTRYPOINT='$TRAEFIK_HTTPS_ENTRYPOINT' \
  TRAEFIK_HTTP_ENTRYPOINT='$TRAEFIK_HTTP_ENTRYPOINT' bash -s" <<'REMOTE'
set -euo pipefail
cd "$REMOTE_DIR"
umask 077
# Secretos: se generan una sola vez y se conservan entre despliegues.
if [ ! -f secrets.env ]; then
  {
    echo "DB_PASSWORD=$(openssl rand -hex 24)"
    echo "DB_ROOT_PASSWORD=$(openssl rand -hex 24)"
    echo "SECRET_KEY_BASE=$(openssl rand -hex 64)"
  } > secrets.env
  echo "secrets.env creado (modo 600)."
fi
# .env = secretos + configuración no secreta (se regenera en cada despliegue).
{
  cat secrets.env
  echo "IMAGE=$IMAGE"
  echo "APP_HOST=$APP_HOST"
  echo "TRAEFIK_NETWORK=$TRAEFIK_NETWORK"
  echo "TRAEFIK_CERTRESOLVER=$TRAEFIK_CERTRESOLVER"
  echo "TRAEFIK_HTTPS_ENTRYPOINT=$TRAEFIK_HTTPS_ENTRYPOINT"
  echo "TRAEFIK_HTTP_ENTRYPOINT=$TRAEFIK_HTTP_ENTRYPOINT"
} > .env
docker compose up -d --remove-orphans
REMOTE

# ---------- 4. Verificación ----------
say "Esperando a que la app responda en https://$APP_HOST/up"
for i in $(seq 1 60); do
  code="$(curl ${CURL_INSECURE:+-k} -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$APP_HOST/up" || true)"
  if [[ "$code" == "200" ]]; then
    echo "OK: https://$APP_HOST está en línea."
    echo "Token de Tienda Demo:"
    "${SSH[@]}" "cd '$REMOTE_DIR' && docker compose exec -T web ./bin/rails runner 'print Project.find_by(slug: \"tienda-demo\")&.api_token'"
    echo
    exit 0
  fi
  sleep 5
done
echo "La app no respondió con 200 a tiempo (último código: $code). Logs:" >&2
"${SSH[@]}" "cd '$REMOTE_DIR' && docker compose ps && docker compose logs --tail 40 web" >&2
exit 1
