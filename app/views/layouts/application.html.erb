<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= [content_for(:title), "QA Pulse"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="QA Pulse">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <div class="wrap topbar__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__pulse" aria-hidden="true"></span> QA Pulse
        <% end %>
        <nav aria-label="Principal"><%= link_to "Proyectos", projects_path %></nav>
      </div>
    </header>

    <main id="contenido" class="wrap">
      <% if notice.present? %><p class="flash flash--ok" role="status"><%= notice %></p><% end %>
      <% if alert.present? %><p class="flash flash--error" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>

    <footer class="wrap footer">QA Pulse · Proyecto final de Sistemas Web · Rails <%= Rails.version %></footer>
  </body>
</html>
